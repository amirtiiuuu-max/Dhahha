local function setupVisualsTab()
    local frame = ContentFrames["Visuals"]
    local espBtn = Instance.new("TextButton")
    espBtn.Size = UDim2.new(0.45, 0, 0, 44)
    espBtn.Position = UDim2.new(0.02, 0, 0.05, 0)
    espBtn.BackgroundColor3 = Color3.fromRGB(45,45,50)
    round(espBtn, 8)
    espBtn.Text = "ESP: OFF"
    espBtn.Font = Enum.Font.GothamBold
    espBtn.Parent = frame
    
    local espEnabled = false
    espBtn.MouseButton1Click:Connect(function()
        espEnabled = not espEnabled
        espBtn.Text = "ESP: " .. (espEnabled and "ON" or "OFF")
        espBtn.BackgroundColor3 = espEnabled and Color3.fromRGB(0,100,0) or Color3.fromRGB(45,45,50)
        if espEnabled then
            local function addESP()
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LP then
                        local c = p.Character
                        if c and c:FindFirstChild("Head") and not c.Head:FindFirstChild("ESP_Label") then
                            local bill = Instance.new("BillboardGui")
                            bill.Name = "ESP_Label"
                            bill.Size = UDim2.new(0,200,0,40)
                            bill.StudsOffset = Vector3.new(0,1.5,0)
                            bill.AlwaysOnTop = true
                            local label = Instance.new("TextLabel")
                            label.Size = UDim2.new(1,0,1,0)
                            label.BackgroundTransparency = 0.5
                            label.BackgroundColor3 = Color3.new(0,0,0)
                            label.Text = p.Name .. " [" .. math.floor((c:FindFirstChild("Humanoid") and c.Humanoid.Health or 0)) .. "]"
                            label.TextColor3 = Color3.fromRGB(255,100,100)
                            label.Font = Enum.Font.GothamBold
                            label.TextSize = 12
                            label.Parent = bill
                            bill.Parent = c.Head
                        end
                    end
                end
            end
            addESP()
            Players.PlayerAdded:Connect(addESP)
            local conn
            conn = RS.RenderStepped:Connect(function()
                if not espEnabled then conn:Disconnect() end
                addESP()
            end)
        else
            for _, bill in pairs(workspace:GetDescendants()) do
                if bill.Name == "ESP_Label" then bill:Destroy() end
            end
        end
    end)
end

