local function collapse()
    if not State.menuOpen then return end
    State.menuOpen = false
    local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
    local closeSize = UDim2.new(0,0,0,0)
    local closePos = UDim2.new(0, -100, 0.5, -30)
    TS:Create(MainFrame, tweenInfo, {Size = closeSize, Position = closePos}):Play()
    TS:Create(Shadow, tweenInfo, {Size = closeSize + UDim2.new(0,8,0,8), Position = closePos - UDim2.new(0,4,0,4)}):Play()
    
    local icon = Instance.new("TextButton")
    icon.Name = "ZeusIcon"
    icon.Size = UDim2.new(0, 48, 0, 48)
    icon.Position = UDim2.new(0, 12, 0.5, -24)
    icon.BackgroundColor3 = Color3.fromRGB(30,30,35)
    round(icon, 24)
    icon.Text = "⚡"
    icon.TextColor3 = Color3.fromRGB(255,215,0)
    icon.TextSize = 28
    icon.Font = Enum.Font.GothamBold
    icon.Parent = ScreenGui
    
    icon.MouseButton1Click:Connect(function()
        icon:Destroy()
        State.menuOpen = true
        local expandSize = UDim2.new(0, 420, 0, 560)
        local expandPos = UDim2.new(0.5, -210, 0.5, -280)
        TS:Create(MainFrame, tweenInfo, {Size = expandSize, Position = expandPos}):Play()
        TS:Create(Shadow, tweenInfo, {Size = expandSize + UDim2.new(0,8,0,8), Position = expandPos - UDim2.new(0,4,0,4)}):Play()
    end)
end

