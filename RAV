local function getPlayers()
    local list = {}
    for _, p in pairs(Players:GetPlayers()) do
        table.insert(list, p)
    end
    return list
end

local function getChar(p)
    if p and p.Character and p.Character.Parent then
        return p.Character
    end
    return nil
end

local function getHum(p)
    local c = getChar(p)
    return c and c:FindFirstChild("Humanoid")
end

