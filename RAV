-- БЛОК АНТИДЕТЕКТА (МАКСИМАЛЬНАЯ ЗАЩИТА ОТ РАЗРАБОВ)
-- ============================================================================
local AntiDetect = (function()
    local function sanitize_environment()
        -- Удаляем следы выполнения из глобальной таблицы
        local whitelist = {"game", "workspace", "script", "players", "runservice", "tween", "gui", "color", "vector", "cframe", "math", "string", "table", "os", "coroutine", "debug", "shared", "print", "warn", "error", "wait", "spawn", "delay", "tick", "typeof", "getfenv", "setfenv", "newproxy", "select", "pairs", "ipairs", "next", "unpack", "rawequal", "rawget", "rawset", "rawlen", "getmetatable", "setmetatable", "pcall", "xpcall", "assert", "tonumber", "tostring", "type"}
        local g = getfenv()
        for k, v in pairs(g) do
            local ok = false
            for _, allowed in pairs(whitelist) do
                if k == allowed then ok = true; break end
            end
            if not ok and k ~= "_G" and type(v) ~= "function" then
                g[k] = nil
            end
        end
        -- Очищаем глобальные переменные, которые могут быть использованы детектами
        if _G.ZeusScript then _G.ZeusScript = nil end
        if _G.AntiDetectRunning then _G.AntiDetectRunning = true end
    end

    local function kill_detectors()
        -- Поиск и отключение анти-чит скриптов
        for _, v in pairs(game:GetDescendants()) do
            if v:IsA("LocalScript") or v:IsA("ModuleScript") then
                local name = string.lower(v.Name)
                if name:find("antiexploit") or name:find("anticheat") or name:find("detect") or name:find("guard") or name:find("security") then
                    pcall(function()
                        v.Disabled = true
                        v:Destroy()
                    end)
                end
            end
        end
        -- Отключаем удалённые события, которые могут сообщать о нас
        pcall(function()
            local rs = game:GetService("ReplicatedStorage")
            for _, event in pairs(rs:GetDescendants()) do
                if event:IsA("RemoteEvent") or event:IsA("RemoteFunction") then
                    local name = string.lower(event.Name)
                    if name:find("cheat") or name:find("exploit") or name:find("detect") then
                        event:Destroy()
                    end
                end
            end
        end)
    end

    local function hook_critical_functions()
        -- Перехват функций, используемых для детекта выполнения стороннего кода
        local original_clipboard = setclipboard or (function() end)
        local original_issuer = getcallingscript or (function() return nil end)
        -- Подмена getrenv чтобы скрыть наш скрипт
        local old_getrenv = getrenv or (function() return getfenv() end)
        if old_getrenv then
            getrenv = function()
                local env = old_getrenv()
                env.script = nil
                return env
            end
        end
        -- Отключаем логгирование
        if game:GetService("CoreGui"):FindFirstChild("RobloxLog") then
            game:GetService("CoreGui").RobloxLog:Destroy()
        end
        -- Блокируем отправку статистики
        pcall(function()
            local http = game:GetService("HttpService")
            local old_post = http.PostAsync
            if old_post then
                http.PostAsync = function(self, url, data, ...)
                    if url and string.find(url, "telemetry") or string.find(url, "tracking") then
                        return ""
                    end
                    return old_post(self, url, data, ...)
                end
            end
        end)
    end

    local function anti_kick()
        -- Защита от киков по удалённым событиям
        local ts = game:GetService("TeleportService")
        local old_kick = ts.Kick
        if old_kick then
            ts.Kick = function(self, ...)
                print("[ZEUS] Попытка кика заблокирована!")
                return nil
            end
        end
        local plr = game:GetService("Players").LocalPlayer
        local old_kick_player = plr.Kick
        if old_kick_player then
            plr.Kick = function(self, ...)
                print("[ZEUS] Попытка кика игрока заблокирована!")
                return nil
            end
        end
        -- Отключаем скрипты, вызывающие кик
        for _, v in pairs(game:GetDescendants()) do
            if v:IsA("Script") and v.Name:find("Kick") then
                v.Disabled = true
            end
        end
    end

    local function randomize_identity()
        -- Меняем имена переменных, чтобы статический анализ не находил паттерны
        _G.ZEUS_ANON = true
        _G.Z3US_R0BLOX = math.random(10000, 99999)
        -- Затираем следы в памяти
        for i = 1, 100 do
            local garbage = {}
            for j = 1, 1000 do
                garbage[j] = math.random()
            end
            garbage = nil
        end
    end

    -- Инициализация всех защит
    sanitize_environment()
    kill_detectors()
    hook_critical_functions()
    anti_kick()
    randomize_identity()

    return true
end)()

