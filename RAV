-- 4. АДМИН-КОМАНДЫ
-- ============================================================================
local Commands = {}

function Commands.kill(p)
    local h = getHum(p)
    if h then h.Health = 0 end
end

function Commands.heal(p)
    local h = getHum(p)
    if h then h.Health = h.MaxHealth end
end

function Commands.bring(p)
    local targetChar = getChar(p)
    local localChar = getChar(LP)
    if targetChar and localChar and localChar.PrimaryPart then
        targetChar:SetPrimaryPartCFrame(localChar.PrimaryPart.CFrame)
    end
end

function Commands.tpTo(p)
    local targetChar = getChar(p)
    local localChar = getChar(LP)
    if targetChar and localChar and targetChar.PrimaryPart then
        localChar:SetPrimaryPartCFrame(targetChar.PrimaryPart.CFrame + Vector3.new(0, 2, 0))
    end
end

function Commands.godMode(enable)
    State.god = enable
    local h = getHum(LP)
    if h then
        if enable then
            h.MaxHealth = math.huge
            h.Health = math.huge
            h.BreakJointsOnDeath = false
        else
            h.MaxHealth = 100
            h.Health = 100
            h.BreakJointsOnDeath = true
        end
    end
end

function Commands.setSpeed(val)
    State.speed = math.clamp(val, 16, 350)
    local h = getHum(LP)
    if h then h.WalkSpeed = State.speed end
end

function Commands.setJumpPower(val)
    State.jumpPower = math.clamp(val, 20, 500)
    local h = getHum(LP)
    if h then h.JumpPower = State.jumpPower end
end

function Commands.infiniteJump(enable)
    State.infJump = enable
end

function Commands.fly(enable)
    State.fly = enable
    local c = getChar(LP)
    if not c then return end
    local root = c:FindFirstChild("HumanoidRootPart") or c.PrimaryPart
    if enable then
        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Velocity = Vector3.new(0,0,0)
        bv.Parent = root
        c._flyBV = bv
    else
        if c._flyBV then c._flyBV:Destroy() end
    end
end

function Commands.noclip(enable)
    State.noclip = enable
    local c = getChar(LP)
    if c then
        for _, part in pairs(c:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = not enable
            end
        end
    end
end

-- Обновление noclip после смены персонажа
LP.CharacterAdded:Connect(function(char)
    wait(0.3)
    if State.noclip then
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
    if State.fly then
        local root = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
        if root then
            local bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bv.Velocity = Vector3.new(0,0,0)
            bv.Parent = root
            char._flyBV = bv
        end
    end
end)

-- Бесконечный прыжок
RS.RenderStepped:Connect(function()
    if State.infJump and UIS:IsKeyDown(Enum.KeyCode.Space) then
        local h = getHum(LP)
        if h and h:GetState() ~= Enum.HumanoidStateType.Jumping then
            h:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
end)

-- Управление полётом
RS.RenderStepped:Connect(function()
    if not State.fly then return end
    local c = getChar(LP)
    if not c or not c._flyBV then return end
    local cam = workspace.CurrentCamera
    local dir = Vector3.new()
    if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.CFrame.LookVector end
    if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.CFrame.LookVector end
    if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.CFrame.RightVector end
    if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.CFrame.RightVector end
    if UIS:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0,1,0) end
    if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0,1,0) end
    if dir.Magnitude > 0 then
        dir = dir.Unit * State.flySpeed
    end
    c._flyBV.Velocity = dir
end)

