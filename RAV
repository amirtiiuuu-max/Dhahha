local function getPlayers()
    local list = {}
    for _, plr in pairs(Players:GetPlayers()) do
        table.insert(list, plr)
    end
    return list
end

local function getCharacter(plr)
    if plr and plr.Character and plr.Character.Parent then
        return plr.Character
    end
    return nil
end

local function getHumanoid(plr)
    local char = getCharacter(plr)
    if char then
        return char:FindFirstChild("Humanoid")
    end
    return nil
end

-- ============================================================================
-- ОСНОВНЫЕ АДМИН-КОМАНДЫ
-- ============================================================================
local AdminCommands = {}

function AdminCommands.kill(plr)
    local humanoid = getHumanoid(plr)
    if humanoid then
        humanoid.Health = 0
    end
end

function AdminCommands.heal(plr)
    local humanoid = getHumanoid(plr)
    if humanoid then
        humanoid.Health = humanoid.MaxHealth
    end
end

function AdminCommands.bring(plr)
    local targetChar = getCharacter(plr)
    local localChar = getCharacter(LocalPlayer)
    if targetChar and localChar and localChar.PrimaryPart then
        targetChar:SetPrimaryPartCFrame(localChar.PrimaryPart.CFrame)
    end
end

function AdminCommands.tpTo(plr)
    local targetChar = getCharacter(plr)
    local localChar = getCharacter(LocalPlayer)
    if targetChar and localChar and targetChar.PrimaryPart then
        localChar:SetPrimaryPartCFrame(targetChar.PrimaryPart.CFrame + Vector3.new(0, 2, 0))
    end
end

function AdminCommands.godMode(plr, enable)
    local humanoid = getHumanoid(plr)
    if humanoid then
        if enable then
            humanoid.MaxHealth = math.huge
            humanoid.Health = math.huge
            humanoid.BreakJointsOnDeath = false
        else
            humanoid.MaxHealth = 100
            humanoid.Health = 100
            humanoid.BreakJointsOnDeath = true
        end
    end
end

function AdminCommands.freeze(plr)
    local humanoid = getHumanoid(plr)
    if humanoid then
        humanoid.PlatformStand = not humanoid.PlatformStand
    end
end

function AdminCommands.setSpeed(plr, value)
    local humanoid = getHumanoid(plr)
    if humanoid then
        humanoid.WalkSpeed = value
    end
end

function AdminCommands.setJumpPower(plr, value)
    local humanoid = getHumanoid(plr)
    if humanoid then
        humanoid.JumpPower = value
    end
end

function AdminCommands.infiniteJump(enable)
    AdminData.infiniteJump = enable
end

function AdminCommands.fly(enable)
    AdminData.flyEnabled = enable
    local char = getCharacter(LocalPlayer)
    if not char then return end
    if enable then
        -- Создаём BodyVelocity для полёта
        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(1/0, 1/0, 1/0)
        bv.Velocity = Vector3.new(0, 0, 0)
        bv.Parent = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
        char.FlyBV = bv
    else
        if char.FlyBV then char.FlyBV:Destroy() end
    end
end

function AdminCommands.noclip(enable)
    AdminData.noclipEnabled = enable
    -- Реализация noclip через обработку столкновений
    local char = getCharacter(LocalPlayer)
    if char then
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = not enable
            end
        end
    end
end

-- Обновление noclip при смене персонажа
Players.LocalPlayer.CharacterAdded:Connect(function(char)
    wait(0.5)
    if AdminData.noclipEnabled then
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
    if AdminData.flyEnabled then
        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(1/0, 1/0, 1/0)
        bv.Velocity = Vector3.new(0, 0, 0)
        bv.Parent = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
        char.FlyBV = bv
    end
end)

-- Бесконечный прыжок
RunService.RenderStepped:Connect(function()
    if AdminData.infiniteJump and UserInputService:IsKeyDown(Enum.KeyCode.Space) then
        local humanoid = getHumanoid(LocalPlayer)
        if humanoid and humanoid:GetState() ~= Enum.HumanoidStateType.Jumping then
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
end)

-- Управление полётом (WSAD + мышь)
RunService.RenderStepped:Connect(function()
    if not AdminData.flyEnabled then return end
    local char = getCharacter(LocalPlayer)
    if not char then return end
    local bv = char.FlyBV
    if not bv then return end
    local camera = workspace.CurrentCamera
    local direction = Vector3.new()
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then
        direction = direction + camera.CFrame.LookVector
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then
        direction = direction - camera.CFrame.LookVector
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then
        direction = direction - camera.CFrame.RightVector
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then
        direction = direction + camera.CFrame.RightVector
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
        direction = direction + Vector3.new(0, 1, 0)
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
        direction = direction - Vector3.new(0, 1, 0)
    end
    if direction.Magnitude > 0 then
        direction = direction.Unit * AdminData.flySpeed
    end
    bv.Velocity = direction
end)

