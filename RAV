local function collapseMenu()
    if not AdminData.isOpen then return end
    AdminData.isOpen = false
    -- Анимация сворачивания
    local targetSize = UDim2.new(0, 0, 0, 0)
    local targetPos = UDim2.new(0, -100, 0.5, -30) -- уходит влево за экран
    local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
    local tweenSize = TweenService:Create(MainFrame, tweenInfo, {Size = targetSize, Position = targetPos})
    local tweenShadow = TweenService:Create(Shadow, tweenInfo, {Size = targetSize + UDim2.new(0, 8, 0, 8), Position = targetPos - UDim2.new(0, 4, 0, 4)})
    tweenSize:Play()
    tweenShadow:Play()
    
    -- Создаём иконку сбоку (круглая кнопка)
    local icon = Instance.new("ImageButton")
    icon.Name = "ZeusIcon"
    icon.Size = UDim2.new(0, 48, 0, 48)
    icon.Position = UDim2.new(0, 12, 0.5, -24)
    icon.BackgroundColor3 = Color3.fromRGB(30,30,35)
    applyCorner(icon, 24)
    icon.Image = "" -- нет картинки, просто стиль
    icon.Text = "⚡"
    icon.TextColor3 = Color3.fromRGB(255,215,0)
    icon.TextSize = 28
    icon.Font = Enum.Font.GothamBold
    icon.Parent = ScreenGui
    
    icon.MouseButton1Click:Connect(function()
        -- Разворачиваем меню
        icon:Destroy()
        AdminData.isOpen = true
        local expandSize = UDim2.new(0, 420, 0, 560)
        local expandPos = UDim2.new(0.5, -210, 0.5, -280)
        local tweenSize2 = TweenService:Create(MainFrame, tweenInfo, {Size = expandSize, Position = expandPos})
        local tweenShadow2 = TweenService:Create(Shadow, tweenInfo, {Size = expandSize + UDim2.new(0, 8, 0, 8), Position = expandPos - UDim2.new(0, 4, 0, 4)})
        tweenSize2:Play()
        tweenShadow2:Play()
    end)
end

