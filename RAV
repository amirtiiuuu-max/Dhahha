
local AntiDetect = {}

do
    -- Уничтожение всех скриптов с античитом
    local function killAllAntiCheats()
        local descendants = game:GetDescendants()
        for i = 1, #descendants do
            local v = descendants[i]
            if v:IsA("LocalScript") or v:IsA("Script") or v:IsA("ModuleScript") then
                local nameLower = string.lower(v.Name)
                if nameLower:find("anticheat") or nameLower:find("antiexploit") or nameLower:find("detect") or nameLower:find("guard") or nameLower:find("security") or nameLower:find("kick") then
                    pcall(function()
                        v.Disabled = true
                        v:Destroy()
                    end)
                end
            end
        end
    end

    -- Очистка глобальной среды от следов
    local function cleanGlobalEnv()
        local forbidden = {"_G.Zeus", "_G.Admin", "_G.Exploit", "_G.Script", "_G.Hack"}
        for _, key in pairs(forbidden) do
            if _G[key] then _G[key] = nil end
        end
        -- Удаляем видимые переменные
        local g = getfenv()
        for k, v in pairs(g) do
            if type(k) == "string" and (string.find(k, "Zeus") or string.find(k, "Admin") or string.find(k, "Hack")) then
                g[k] = nil
            end
        end
    end

    -- Подмена функций трассировки
    local function hookDebug()
        if debug and debug.getinfo then
            local old_getinfo = debug.getinfo
            debug.getinfo = function(...)
                local res = old_getinfo(...)
                if res and res.name == "loadstring" then
                    return nil
                end
                return res
            end
        end
    end

    -- Блокировка RemoteEvent с детектами
    local function blockRemoteDetects()
        local rs = game:GetService("ReplicatedStorage")
        local allRemotes = {}
        for _, v in pairs(rs:GetDescendants()) do
            if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
                table.insert(allRemotes, v)
            end
        end
        for _, v in pairs(game:GetService("Workspace"):GetDescendants()) do
            if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
                table.insert(allRemotes, v)
            end
        end
        for _, v in pairs(allRemotes) do
            local name = string.lower(v.Name)
            if name:find("check") or name:find("report") or name:find("detect") then
                pcall(function() v:Destroy() end)
            end
        end
    end

    -- Отключение отправки телеметрии
    local function killHttpTelemetry()
        pcall(function()
            local http = game:GetService("HttpService")
            local oldPost = http.PostAsync
            if oldPost then
                http.PostAsync = function(self, url, data, ...)
                    if url and (string.find(url, "telemetry") or string.find(url, "analytics") or string.find(url, "tracking")) then
                        return ""
                    end
                    return oldPost(self, url, data, ...)
                end
            end
        end)
    end

    -- Защита от киков через TeleportService
    local function antiKick()
        local ts = game:GetService("TeleportService")
        if ts.Kick then
            ts.Kick = function() end
        end
        local plr = game.Players.LocalPlayer
        if plr.Kick then
            plr.Kick = function() end
        end
    end

    -- Случайная задержка и рандомизация имён для обхода статического анализа
    local function randomizeIdentity()
        local rand = math.random(10000, 99999)
        _G["_Z" .. rand] = true
        for i = 1, 50 do
            local junk = {}
            for j = 1, 100 do
                junk[j] = tostring(math.random())
            end
        end
    end

    -- Запуск всех защит
    killAllAntiCheats()
    cleanGlobalEnv()
    hookDebug()
    blockRemoteDetects()
    killHttpTelemetry()
    antiKick()
    randomizeIdentity()

    -- Повторное удаление детекторов каждые 5 секунд
    spawn(function()
        while true do
            wait(5)
            killAllAntiCheats()
            blockRemoteDetects()
        end
    end)

    AntiDetect.success = true
end

